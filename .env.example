# File ExploraViz — copy this file to .env and adapt it.
# For Dockge on TrueNAS, see the .env suggested in the README (step 5).

# User/group the application runs as (dedicated TrueNAS user with read-only access).
PUID=1000
PGID=1000
# Extra groups, comma-separated (e.g. the group holding the read ACL).
SUPPLEMENTARY_GIDS=

TZ=Europe/Paris

# Listening port inside the container, and port published on the host.
PORT=8080
HOST_PORT=8080

# Administrator account created on FIRST start only (afterwards: Configuration page).
# Leave ADMIN_PASSWORD empty to create the account from the web UI.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Initial interval between two automatic scans (0 = disabled). Editable later in the UI.
SCAN_INTERVAL_MINUTES=15

LOG_LEVEL=INFO

# true only behind a reverse proxy that already authenticates users.
AUTH_DISABLED=false
# Reverse proxy IPs allowed to send X-Forwarded-For / X-Forwarded-Proto.
FORWARDED_ALLOW_IPS=127.0.0.1

# Image build (compose.yaml of this repository): source folder and image name.
# FEV_BUILD_CONTEXT=.
# FEV_IMAGE=file-exploraviz:local

# SMB/CIFS share (if you use the nas-smb volume of compose.yaml)
# SMB_HOST=192.168.1.10
# SMB_SHARE=share
# SMB_USER=readonly
# SMB_PASSWORD=change-me
