# File ExploraViz — copy this file to .env (or paste it into Dockge's .env editor) and adapt it.

# Image version: latest (last release), a version such as 1.0.0, or edge (main branch).
FEV_TAG=latest

# Folder holding config/ and cache/. Default: next to compose.yaml.
# With Dockge, use an absolute path, e.g. /mnt/tank/apps/file-exploraviz
APP_DATA=.

# User/group the application runs as (dedicated user with read-only access to the data).
PUID=1000
PGID=1000
# Extra groups, comma-separated (e.g. the group holding the read ACL).
SUPPLEMENTARY_GIDS=

TZ=Europe/Paris

# Port published on the host: the UI is at http://<host>:59125 (the container listens on 8080).
HOST_PORT=59125

# Administrator account created on FIRST start only (afterwards: Settings page).
# Leave ADMIN_PASSWORD empty to create the account from the web UI.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Initial interval between two automatic scans (0 = disabled). Editable later in the UI.
SCAN_INTERVAL_MINUTES=15

LOG_LEVEL=INFO

# true only behind a reverse proxy that already authenticates users.
AUTH_DISABLED=false
# Reverse proxy IPs allowed to send X-Forwarded-For / X-Forwarded-Proto.
FORWARDED_ALLOW_IPS=127.0.0.1

# SMB/CIFS share (if you use the nas-smb volume of compose.yaml)
# SMB_HOST=192.168.1.10
# SMB_SHARE=share
# SMB_USER=readonly
# SMB_PASSWORD=change-me
